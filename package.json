{
  "name": "devils-dust",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "simulate": "tsx scripts/simulate.ts",
    "replay": "tsx scripts/replay.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@babylonjs/core": "^8.0.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "concurrently": "^9.2.0",
    "fast-check": "^4.0.0",
    "prettier": "^3.9.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
